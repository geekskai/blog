  "items": [
    {
      "id": "wav-loss",
      "title": "最近一次断崖主要集中于 WAV 页",
      "queries": [
        {
          "id": "gsc-fortnight",
          "source": {
            "label": "Google Search Console",
            "files": [
              {
                "label": "gsc-14d-comparison Pages.csv / Queries.csv"
              }
            ],
            "metricDefinitions": [
              {
                "label": "点击贡献",
                "definition": "比较两个等长 14 天窗口中的 Web 搜索点击与曝光。"
              }
            ],
            "filters": [
              "资源：geekskai.com 域资源",
              "搜索类型：Web",
              "国家与设备：全部"
            ],
            "caveats": [
              "页面、查询和属性聚合口径不同；98.5% 是页面损失相对属性净损失的近似贡献。两个查询与页面属于同一流量，不能相加。"
            ]
          },
          "reportingPeriod": "2026-09-09–09-22 与 2026-09-23–10-06",
          "columns": [
            "对象",
            "前期点击",
            "后期点击",
            "前期曝光",
            "后期曝光"
          ],
          "rows": [
            {
              "对象": "https://geekskai.com/tools/soundcloud-to-wav/",
              "前期点击": 1212,
              "后期点击": 122,
              "前期曝光": 4750,
              "后期曝光": 550
            },
            {
              "对象": "https://geekskai.com/tools/soundcloud-playlist-downloader/",
              "前期点击": 78,
              "后期点击": 76,
              "前期曝光": 548,
              "后期曝光": 430
            },
            {
              "对象": "soundcloud to wav",
              "前期点击": 396,
              "后期点击": 33,
              "前期曝光": 1500,
              "后期曝光": 76
            },
            {
              "对象": "soundcloud to wav converter",
              "前期点击": 662,
              "后期点击": 2,
              "前期曝光": 2678,
              "后期曝光": 7
            }
          ],
          "preview": {
            "kind": "partial",
            "note": "只展示核心页面及两个查询。"
          },
          "methods": [
            {
              "language": "calculation",
              "code": "全站净损失 = 1340 - 233 = 1107\nWAV 页净损失 = 1212 - 122 = 1090\n1090 / 1107 × 100 = 98.46%\n两个查询净损失 = (662 - 2) + (396 - 33) = 1023\n1023 / 1107 × 100 = 92.41%"
            }
          ]
        }
      ]
    },
